# Copy this file to .env and adjust as needed.
# All values shown are the application's defaults.

# --- Ollama (local LLM) ---
# Model must already be pulled: `ollama pull llama3.2`
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434
SYSTEM_PROMPT=You are a helpful, concise voice assistant. Keep replies short and conversational since they will be read aloud.

# --- Pocket TTS (local text-to-speech) ---
# See available voices at https://github.com/kyutai-labs/pocket-tts
# (e.g. alba, anna, charles, eve, george, jane, michael, paul, vera, ...)
# You may also point this at a local .wav file or an "hf://..." voice
# reference for voice cloning.
TTS_VOICE=alba
TTS_LANGUAGE=english

# --- SenseVoice (local speech-to-text) ---
STT_MODEL=iic/SenseVoiceSmall
STT_DEVICE=cpu
# auto, zh, en, yue, ja, ko
STT_LANGUAGE_CODE=auto

# --- Output ---
OUTPUT_DIR=./output
OUTPUT_FILENAME=response.wav

# --- CLI ---
# Comma-separated list of words that end the session.
EXIT_COMMANDS=exit,quit,bye,:q
